{
  "name": "highlighter-snowshot",
  "version": "2.1.0-beta.0",
  "description": "Highlighter - 截图、标注、OCR、翻译与 AI 桌面效率工具",
  "main": "main.js",
  "author": "Highlighter",
  "scripts": {
    "postinstall": "install-electron --no",
    "test": "node --test test/*.test.js",
    "test:runtime": "node --test test/electron-runtime.test.js",
    "check:version": "node scripts/check-version.js",
    "verify:fuses": "node scripts/verify-electron-fuses.js",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1 -RequireSignature",
    "stop:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-running.ps1",
    "build:smart-select": "powershell -NoProfile -ExecutionPolicy Bypass -File native/smart-select/build.ps1",
    "build:ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File native/ocr/build.ps1",
    "build:native": "npm run stop:app && npm run build:smart-select && npm run build:ocr",
    "check": "node scripts/check-js.js",
    "test:long-capture": "node tests/long-capture.test.js",
    "prestart": "npm run build:native",
    "start": "electron .",
    "prebuild:win": "npm run build:native",
    "build:win": "electron-builder --win nsis --x64",
    "prebuild:win:portable": "npm run build:native",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.highlighter.desktop",
    "productName": "Highlighter",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/screenshot-desktop/lib/win32/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "native/smart-select/SmartSelect.exe",
        "to": "native/smart-select/SmartSelect.exe"
      },
      {
        "from": "native/ocr",
        "to": "native/ocr",
        "filter": [
          "HighlighterOcrSidecar.exe",
          "*.dll"
        ]
      },
      {
        "from": "ocr/models",
        "to": "ocr/models"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-action.js",
      "preload-toolbar.js",
      "preload-capture.js",
      "preload-long-capture.js",
      "preload-long-overlay.js",
      "preload-pin.js",
      "preload-recognition.js",
      "preload-record.js",
      "preload-record-frame.js",
      "deepseek.js",
      "main/**/*",
      "assets/**/*",
      "config/**/*",
      "toolbar/**/*",
      "action/**/*",
      "capture/**/*",
      "long-capture/**/*",
      "pin/**/*",
      "recognition/**/*",
      "record/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Highlighter-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Highlighter"
    },
    "portable": {
      "artifactName": "Highlighter-${version}-portable.exe"
    }
  },
  "dependencies": {
    "dompurify": "3.4.13",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.3.0",
    "jsqr": "^1.4.0",
    "openai": "^4.87.3",
    "screenshot-desktop": "^1.15.4",
    "selection-hook": "^2.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "^3.6.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "onnxruntime-node": "^1.24.2"
  },
  "allowScripts": {
    "electron": true,
    "selection-hook": true,
    "@electron/rebuild": true,
    "electron-builder": true,
    "ffmpeg-static": true,
    "sharp": true,
    "electron-winstaller@5.4.0": true,
    "onnxruntime-node@1.24.2": true
  }
}
