{
  "name": "highlighter-snowshot",
  "version": "2.2.2",
  "description": "Highlighter - 截图、标注、OCR、翻译与 AI 桌面效率工具",
  "main": "main.js",
  "author": "Highlighter",
  "scripts": {
    "postinstall": "install-electron --no",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:update-rehearsal": "node --test test/update-rehearsal.test.js",
    "bench:performance": "node scripts/benchmark-performance.js",
    "test:coverage": "npm run test:coverage:loaded && npm run test:coverage:native && npm run test:coverage:critical",
    "test:coverage:loaded": "c8 --clean --check-coverage --lines 85 --include=main/services/**/*.js --include=main/ipc/**/*.js --include=record/**/*.js --include=toolbar/**/*.js --include=long-capture/**/*.js --include=capture/selection-utils.js --reporter=text-summary node --test --test-reporter=dot test/*.test.js tests/long-capture.test.js",
    "test:coverage:native": "c8 --clean --check-coverage --per-file --lines 60 --include=main/services/ocr-service.js --include=main/services/long-capture-session.js --reporter=text node --test test/ocr-service.test.js test/data-root.test.js tests/long-capture.test.js",
    "test:coverage:critical": "c8 --clean --check-coverage --per-file --lines 90 --include=main/services/update-service.js --include=main/services/diagnostics-service.js --include=main/services/window-security.js --reporter=text node --test test/update-service.test.js test/diagnostics-service.test.js test/window-security.test.js",
    "test:runtime": "node --test test/electron-runtime.test.js",
    "check:version": "node scripts/check-version.js",
    "verify:fuses": "node scripts/verify-electron-fuses.js",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1 -RequireSignature",
    "collect:hardware": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-hardware-evidence.ps1",
    "verify:hardware": "node scripts/verify-hardware-matrix.js",
    "stop:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-running.ps1",
    "build:smart-select": "powershell -NoProfile -ExecutionPolicy Bypass -File native/smart-select/build.ps1",
    "build:ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File native/ocr/build.ps1",
    "build:native": "npm run stop:app && npm run build:smart-select && npm run build:ocr",
    "check": "node scripts/check-js.js",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:long-capture": "node tests/long-capture.test.js",
    "prestart": "npm run build:native",
    "start": "electron .",
    "prebuild:win": "npm run build:native",
    "build:win": "electron-builder --win nsis --x64",
    "prebuild:win:portable": "npm run build:native",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.highlighter.desktop",
    "productName": "Highlighter",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/screenshot-desktop/lib/win32/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "native/smart-select/SmartSelect.exe",
        "to": "native/smart-select/SmartSelect.exe"
      },
      {
        "from": "native/ocr",
        "to": "native/ocr",
        "filter": [
          "HighlighterOcrSidecar.exe",
          "*.dll"
        ]
      },
      {
        "from": "ocr/models",
        "to": "ocr/models"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-action.js",
      "preload-toolbar.js",
      "preload-capture.js",
      "preload-long-capture.js",
      "preload-long-overlay.js",
      "preload-pin.js",
      "preload-recognition.js",
      "preload-record.js",
      "preload-record-frame.js",
      "deepseek.js",
      "main/**/*",
      "assets/**/*",
      "config/**/*",
      "toolbar/**/*",
      "action/**/*",
      "capture/**/*",
      "long-capture/**/*",
      "pin/**/*",
      "recognition/**/*",
      "record/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Highlighter-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Highlighter"
    },
    "portable": {
      "artifactName": "Highlighter-${version}-portable.exe"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "dompurify": "3.4.13",
    "electron-store": "^8.2.0",
    "electron-updater": "6.8.9",
    "ffmpeg-static": "^5.3.0",
    "jsqr": "^1.4.0",
    "openai": "^4.87.3",
    "screenshot-desktop": "^1.15.4",
    "selection-hook": "^2.0.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.62.1",
    "c8": "12.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "onnxruntime-node": "1.27.0"
  },
  "allowScripts": {
    "electron": true,
    "selection-hook": true,
    "@electron/rebuild": true,
    "electron-builder": true,
    "ffmpeg-static": true,
    "sharp": true,
    "electron-winstaller@5.4.0": true,
    "onnxruntime-node@1.27.0": true
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    }
  }
}
